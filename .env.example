# Google Gemini API Key for AI Whiteboard
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway & Webhook Integration (Backend / Serverless)
# Hosted Link: https://razorpay.me/@aiwhiteboardone
# Get your API keys from Razorpay Dashboard > Settings > API Keys:
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret from Razorpay Dashboard > Settings > Webhooks:
# Set Webhook URL to: https://<your-domain>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
